{
  "realm": "agentbuilder-dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "플랫폼 관리자" },
      { "name": "agent-developer", "description": "AI 엔지니어" },
      { "name": "domain-editor", "description": "현업 도메인 전문가" },
      { "name": "reviewer", "description": "검토자/승인자" },
      { "name": "viewer", "description": "뷰어" },
      { "name": "end-user", "description": "최종 사용자" }
    ]
  },
  "clients": [
    {
      "clientId": "agentbuilder-studio",
      "name": "AgentBuilder Studio (dev)",
      "publicClient": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8000/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8000"]
    },
    {
      "clientId": "agentbuilder-api",
      "name": "AgentBuilder api-server (dev, resource server)",
      "publicClient": false,
      "secret": "dev-only-not-for-production",
      "enabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "dev-admin",
      "email": "dev-admin@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dev-admin", "temporary": false }],
      "realmRoles": ["platform-admin"]
    },
    {
      "username": "dev-ehs-editor",
      "email": "dev-ehs-editor@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dev-ehs-editor", "temporary": false }],
      "realmRoles": ["domain-editor"]
    }
  ]
}
