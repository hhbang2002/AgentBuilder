# 로컬 개발용 환경변수 예시. 복사해서 .env로 사용: cp .env.example .env
# platform/adapters/settings.py의 Settings가 AGENTBUILDER_ 접두사로 읽는다.
# deploy/compose/dev.yml이 노출하는 기본 포트와 일치한다.

AGENTBUILDER_ENVIRONMENT=dev
AGENTBUILDER_DATABASE_URL=postgresql+asyncpg://agentbuilder:agentbuilder@localhost:5432/agentbuilder
AGENTBUILDER_REDIS_URL=redis://localhost:6379/0
